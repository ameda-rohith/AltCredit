# Copy to .env and adjust. Nothing here is required for a local demo.
DATABASE_URL=sqlite:///./altcredit.db
# Password of the seeded demo users/lenders (README: default altcredit-demo)
DEMO_PASSWORD=altcredit-demo
# HMAC key for access tokens. REQUIRED for anything shared: with the built-in dev default
# anyone can mint tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
BANK_API_URL=http://127.0.0.1:8001
BANK_API_KEY=change-me-too

# LLM explainer (Ollama Cloud). Empty = /explain answers 503.
OLLAMA_API_KEY=
